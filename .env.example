# Demo deployment configuration
# Dùng bởi scripts/deploy-demo.mjs (npm run deploy:demo) để rsync/scp
# thư mục demo-dist/ lên server sau khi build.
# Copy file này thành .env rồi điền giá trị thật (.env đã gitignore, KHÔNG commit).

# Địa chỉ IP hoặc hostname của server đích
DEPLOY_HOST=172.16.2.100

# User SSH dùng để đăng nhập vào server đích
DEPLOY_USER=root

# Port SSH của server đích (mặc định 22 nếu bỏ trống)
DEPLOY_PORT=22

# Đường dẫn thư mục trên server sẽ nhận nội dung demo-dist/
# (rsync --delete sẽ xoá các file thừa không còn trong demo-dist/)
DEPLOY_PATH=/var/www/sdk-playground/

# ─────────────────────────────────────────────────────────────────────────
# NPM publish token — dùng khi chạy release:patch / release:minor / release:major
# Tạo tại: npmjs.com → Access Tokens → Generate New Token (loại "Automation"
# hoặc "Granular Access Token" scope theo package @xorcloud/stack-ai-chat-sdk).
#
# LƯU Ý: npm CLI KHÔNG tự đọc file .env này. Muốn dùng NPM_TOKEN, chọn 1 trong 2 cách:
#   1. export NPM_TOKEN=npm_xxx trước khi chạy npm run release:*
#   2. Thêm dòng sau vào ~/.npmrc: //registry.npmjs.org/:_authToken=${NPM_TOKEN}
# Không commit token thật vào repo.
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
